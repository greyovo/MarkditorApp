{
  "build": {
    "beforeBuildCommand": "npm run build:before_tauri",
    "beforeDevCommand": "npm run dev:before_tauri",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "",
    "targets": "all",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "fragmentPaths": [
          "config\\wix-config.wxs"
        ],
        "componentRefs": [
          "Entries1",
          "Entries2",
          "Entries3"
        ]
      }
    },
    "longDescription": "",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "resources": [],
    "shortDescription": "",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "productName": "Markditor",
  "mainBinaryName": "Markditor",
  "version": "1.0.0",
  "identifier": "Me.GreyApps.Markditor",
  "plugins": {
    "cli": {
      "description": "Markditor CLI",
      "longDescription": "Markditor App CLI.",
      "args": [
        {
          "name": "source",
          "description": "The source path of a markdown file.",
          "index": 1,
          "takesValue": true,
          "required": false
        }
      ]
    }
  },
  "app": {
    "security": {
      "assetProtocol": {
        "scope": [
          "**/*",
          "assets/**/*",
          "dist/vditor/**/*"
        ],
        "enable": true
      }
    },
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "decorations": false,
        "height": 600,
        "resizable": true,
        "title": "Markditor",
        "width": 1000,
        "useHttpsScheme": true
      }
    ]
  }
}